# Fins de ligne LF partout, quel que soit core.autocrlf (cf. .editorconfig).
* text=auto eol=lf

# Scripts Windows : CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaires : ni conversion ni diff texte.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.mp4 binary
*.woff2 binary
*.ttf binary
