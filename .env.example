# Copier en .env et remplir les vraies valeurs. Ne jamais committer .env.

# Base de données (même valeurs que docker-compose.yml)
POSTGRES_USER=coffee
POSTGRES_PASSWORD=change-me
POSTGRES_DB=coffee_qr
DATABASE_URL=postgresql://coffee:change-me@localhost:5432/coffee_qr
# Base des tests du serveur (créée et vidée par npm test, même serveur Postgres)
TEST_DATABASE_URL=postgresql://coffee:change-me@localhost:5432/coffee_qr_test

# Serveur
PORT=3000
SESSION_DAYS=30
# Blocage temporaire d'un compte après 5 essais ratés (minutes)
LOGIN_LOCK_MINUTES=5
# Essais de connexion autorisés par adresse IP et par minute
LOGIN_RATE_LIMIT_PER_MINUTE=10
FIRST_MANAGER_LOGIN=manager
FIRST_MANAGER_TEMP_PASSWORD=change-me
# Une commande en attente (QR ou commande offerte depuis l'app) expire après ce délai (secondes)
ORDER_PENDING_TTL_SECONDS=300
# Anti-abus : au plus N commandes QR par jeton de table sur la fenêtre (minutes)
QR_ORDER_RATE_LIMIT=10
QR_ORDER_RATE_WINDOW_MINUTES=10
# Heure (Africa/Tunis) où les shifts oubliés se terminent automatiquement
SHIFT_AUTO_END_TIME=04:00
# Passation (Africa/Tunis) : à SHIFT_2_START, le serveur qui a démarré son shift comme « Shift 2 »
# devient automatiquement principal
SHIFT_2_START=15:00
# Adresse du menu QR, pour les liens des tables (npm run seed:dev-tables)
CUSTOMER_WEB_URL=http://localhost:5173

# Notifications push (Web Push, clés VAPID). Paire générée par : npx web-push generate-vapid-keys
# (dans server/). Vides : l'app marche sans notifications push. VITE_VAPID_PUBLIC_KEY (lue par
# staff-app) doit être exactement VAPID_PUBLIC_KEY. En production, ne jamais changer la paire :
# tous les téléphones devraient se réabonner.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
VITE_VAPID_PUBLIC_KEY=

# Agent caisse : clé attendue par le serveur (vide = agent refusé). La même valeur va dans
# pos-agent/.env, avec les autres réglages de l'agent (modèle : pos-agent/.env.example).
AGENT_KEY=change-me-long-random-string
