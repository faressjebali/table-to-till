# Réglages de l'agent caisse : copier en pos-agent/.env (jamais committé).
# Sur un poste de développement, scripts/start-day.sh le crée s'il manque.

# API du serveur (Socket.IO est à la racine du même serveur)
SERVER_URL=http://localhost:3000/api
# Même valeur que AGENT_KEY dans le .env du serveur
AGENT_KEY=change-me-long-random-string
# Code caisse commun aux serveurs (pas le code admin). Le vrai code n'est écrit que dans le .env du
# PC de caisse ; avec l'émulateur, le PIN de test passé à --pin (ex. 0000).
LEGACY_PIN=0000
# Secondes sans souris ni clavier avant que l'agent agisse dans la caisse
AGENT_IDLE_SECONDS=5
# Secondes entre deux lectures de la file quand le temps réel ne prévient pas
AGENT_POLL_SECONDS=5
