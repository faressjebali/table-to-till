{
  "name": "coffee-qr-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node --env-file=../.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up",
    "migrate:down": "node --env-file=../.env node_modules/node-pg-migrate/bin/node-pg-migrate.js down",
    "seed": "tsx --env-file=../.env src/seed/index.ts",
    "tables:links": "tsx --env-file=../.env src/seed/table-links.ts"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "csv-parse": "^6.2.1",
    "express": "^5.3.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
